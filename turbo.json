{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["PORT"],
      "inputs": ["$TURBO_DEFAULT$", "**/.env", "**/.env.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "env": ["PORT"],
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["PORT"],
      "persistent": true
    }
  }
}
